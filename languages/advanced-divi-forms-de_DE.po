msgstr "Die Quelle dieses Divi-Formulars ist nicht eindeutig. Speichern oder suchen Sie die Quellseite zuerst erneut."

#. translators: %s: minimum supported Divi version.
#: includes/divi-support.php:115
#, php-format
msgid "Advanced Divi Forms needs Divi %s or newer. No Divi theme is active, so contact-form answers, emails, templates and exports are not handled yet."
msgstr "Advanced Divi Forms benötigt Divi %s oder neuer. Es ist kein Divi-Theme aktiv, daher werden Antworten, E-Mails, Vorlagen und Exporte von Kontaktformularen noch nicht verarbeitet."

#. translators: 1: minimum supported Divi version, 2: theme name, 3: detected version.
#: includes/divi-support.php:121
#, php-format
msgid "Advanced Divi Forms needs Divi %1$s or newer, but %2$s %3$s is active. Update Divi before relying on the integration."
msgstr "Advanced Divi Forms benötigt Divi %1$s oder neuer, aktiv ist jedoch %2$s %3$s. Aktualisieren Sie Divi, bevor Sie sich auf die Integration verlassen."

#: includes/divi-support.php:142
msgid "Not detected - no Divi theme is active"
msgstr "Nicht erkannt – kein Divi-Theme aktiv"

#. translators: 1: theme name, 2: version, 3: minimum version.
#: includes/divi-support.php:146
#, php-format
msgid "%1$s %2$s (supported, needs %3$s or newer)"
msgstr "%1$s %2$s (unterstützt, benötigt %3$s oder neuer)"

#. translators: 1: theme name, 2: version, 3: minimum version.
#: includes/divi-support.php:149
#, php-format

msgstr "Optionale Bestätigung, die erst nach erfolgreichem Empfänger-Versand gesendet wird. Standardmäßig deaktiviert."

#: includes/divi-integration.php:67
msgid "Sender Email Field ID"
msgstr "Feld-ID der Absender-E-Mail"

